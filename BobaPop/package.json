{
  "name": "bobapop",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:clean": "expo run:ios --no-build-cache",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:levels": "node scripts/check-levels.js",
    "check:save-migrations": "node scripts/check-save-migrations.js",
    "preflight": "npm run typecheck && npm run check:levels && npm run check:save-migrations && npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "^55.0.17",
    "expo": "~55.0.31",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.18",
    "expo-iap": "^4.3.1",
    "expo-linear-gradient": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-google-mobile-ads": "^16.3.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "private": true
}
