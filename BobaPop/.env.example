# Public values embedded in the client. Never put credentials or API secrets here.
# AdMob app IDs use ~; rewarded unit IDs use /. Development uses Google's test ads.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_UNIT_ID=

# Optional placement-specific rewarded units. Each falls back to REWARDED above.
# Create separate rewarded units in AdMob to compare and optimize placements.
EXPO_PUBLIC_ADMOB_CONTINUE_IOS_UNIT_ID=
EXPO_PUBLIC_ADMOB_ENERGY_IOS_UNIT_ID=
EXPO_PUBLIC_ADMOB_CLEAR_BONUS_IOS_UNIT_ID=
EXPO_PUBLIC_ADMOB_CONTINUE_ANDROID_UNIT_ID=
EXPO_PUBLIC_ADMOB_ENERGY_ANDROID_UNIT_ID=
EXPO_PUBLIC_ADMOB_CLEAR_BONUS_ANDROID_UNIT_ID=

# Reward tuning (1–3). Defaults preserve the current Energy economy and continue caps.
EXPO_PUBLIC_ENERGY_AD_REWARD=2
EXPO_PUBLIC_CONTINUE_AD_LIVES=2

# Both must be false for production. Preview builds may opt into test ads.
EXPO_PUBLIC_ADMOB_USE_TEST_ADS=false
EXPO_PUBLIC_ALLOW_TEST_ADS_IN_RELEASE=false

# Optional HTTPS endpoint. No analytics are queued or sent when unset.
EXPO_PUBLIC_ANALYTICS_ENDPOINT=
